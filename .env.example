# Copy this file to .env and fill in the values for your store.
# .env is gitignored. Never commit real values.
#
# After editing, regenerate the theme config:
#   node scripts/generate-config.js

# BigCommerce store hash. An opaque ID such as 3mhucbxfyj -- NOT your store's
# subdomain or display name. Take it from the API path of a store API account
# (https://api.bigcommerce.com/stores/<store_hash>/v3/) under
# Settings > API accounts.
LR_STORE_NAME=

# LoginRadius API Key (Admin Console > Tenant Settings > API Credentials).
# Public by design: it ships in the theme bundle.
LR_API_KEY=

# LoginRadius tenant / Site name. Used for the SSO hub host:
#   https://<LR_TENANT_NAME>.hub.loginradius.com
LR_TENANT_NAME=

# Optional. Only set this if your LoginRadius app name differs from the tenant
# name. Left empty, appName falls back to LR_TENANT_NAME.
LR_APP_NAME=

# Optional. Leave EMPTY unless you know you need it.
# A SOTT authorises registration from the browser and is only required when Bot
# Protection (Captcha) is disabled in the Admin Console. SOTTs expire (10
# minutes by default) and anything placed here is readable in the theme bundle,
# so the supported setup is: enable Captcha, leave this blank.
LR_SOTT=
